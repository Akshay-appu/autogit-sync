{
  "name": "autogit-sync",
  "displayName": "AutoGit Sync",
  "description": "Auto-syncs error-free code to GitHub on Ctrl+S",
  "version": "0.0.5",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "SCM Providers",
    "Education"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "title": "AutoGit: Connect Folder to GitHub Repo",
        "command": "autogit-sync.connectRepo"
      },
      {
        "title": "AutoGit: Push Entire Folder to GitHub",
        "command": "autogit-sync.pushFolder"
      },
      {
        "title": "AutoGit: Set Default GitHub Repo (Single Files)",
        "command": "autogit-sync.setDefaultRepo"
      },
      {
        "title": "AutoGit: Set Gemini API Key (AI Commit Messages)",
        "command": "autogit-sync.setApiKey"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "publisher": "AkshayKumarKN",
  "icon": "icon.png",
  "galleryBanner": {
    "theme": "dark",
    "color": "#001021"
  },
  "author": "Akshay Kumar K N",
  "license": "MIT",
  "keywords": [
    "github",
    "git",
    "auto-commit",
    "auto-push",
    "sync",
    "student",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Akshay-appu/autogit-sync.git"
  }
}
